* text=auto

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore

# Los lanzadores los ejecuta Windows: deben viajar siempre con fin de linea
# de Windows, sin depender de la configuracion de cada maquina.
*.cmd text eol=crlf
*.bat text eol=crlf
