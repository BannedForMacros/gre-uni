APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guia_electronica
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Activa consignados (marca en SQL Server). Solo clientes que la usan. Default: false
CONSIGNADOS_ENABLED=false

# --- ApiGRE: único canal hacia el SQL Server del cliente --------------------
# Raiz de la ApiGRE, SIN ruta: de aqui salen /GREDMK y /api/v1
GRE_API_URL=http://localhost:8181
GRE_API_KEY=
GRE_API_TIMEOUT=30

# --- Negocio ---------------------------------------------------------------
# Única fuente de verdad del IGV en la aplicación.
GRE_IGV_TASA=0.18

# --- Datos de la empresa (los usa ParametroSeeder en la instalación) --------
# Después se administran desde Configuraciones > Configuración de Empresa.
GRE_RUC=
GRE_RAZON_SOCIAL=
GRE_DIRECCION=
GRE_FACTURACION_CREDENCIAL=
GRE_FACTURACION_URL=
GRE_FACTURACION_CONSULTAS_URL=
